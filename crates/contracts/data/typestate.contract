# Generalised typestate / protocol tracker (use-after-scope B, missing-check E, order G5).
#
# A named resource (keyed by its pointer base or scalar identity) moves through a finite set
# of states via `typestate-set` transitions; `typestate-require[-not]` obligations flag a use
# in a forbidden state. All contract-driven — new protocols are new contract lines, not code.
# A bug-finding-only check; a violation is refuted only when the resource is *definitely* in
# the forbidden state on the path (states are meet-joined at merges — no false FAIL).

# --- stdio handle: use-after-close and double-close (FILE* is a pointer handle) -----------
# fopen returns an OPEN handle. A handle still `open` at return (see typestate-leak) — not
# closed and not returned — is a resource leak (K).
[fopen fdopen freopen tmpfile]
typestate-set ret file open
typestate-leak file open

# fclose closes it — and refuses to close an already-closed handle (double-close).
[fclose]
typestate-require-not arg0 file closed
typestate-set arg0 file closed

# An operation on a stream whose handle is arg0 must not run on a closed handle.
[fflush fseek ftell feof ferror fileno rewind clearerr]
typestate-require-not arg0 file closed

# fread(ptr,size,nmemb,stream) / fwrite(...): the stream is arg3 — use-after-close.
[fread fwrite]
typestate-require-not arg3 file closed

# --- missing permission check (E): a privileged op requires a prior validation ------------
# A recognised check marks the object validated.
[security_check validate_access authorize_request]
typestate-set arg0 perm checked

# The privileged operation requires the object to have been checked first.
[privileged_write]
typestate-require arg0 perm checked

# --- TOCTOU (G2): a check invalidated by an intervening yield ------------------------------
# access()/stat() validate a path — it becomes `checked`.
[access stat lstat faccessat]
typestate-set arg0 toctou checked

# A yield (blocking call, reschedule, sleep) lets an adversary act: every `checked` path
# becomes `stale`. The yield lives on the blocking primitives' blocks in
# kernel_sync.contract (`schedule`/`msleep`/`ssleep`/`cond_resched`/`mutex_lock`/`down`),
# since one name has exactly one contract block.

# Using (open) a path whose check went stale across a yield is a TOCTOU race.
[open openat fopen_path]
typestate-require-not arg0 toctou stale

# --- Reference counts (G8): a decrement below zero is a premature free / UAF ---------------
[kref_get refcount_inc kobject_get get_task_struct atomic_inc_not_zero]
refcount-inc arg0 kref

[kref_put refcount_dec kobject_put put_task_struct refcount_dec_and_test]
refcount-dec arg0 kref

# --- Type confusion (H): a per-object type tag, checked at a typed operation ---------------
# An allocator/initialiser stamps the object's type; a typed op requires the matching tag.
[init_as_request]
typestate-set arg0 objtype request

[init_as_reply]
typestate-set arg0 objtype reply

[handle_request]
typestate-require arg0 objtype request

# --- Extended file protocol: more accessors that must not run on a closed stream (use-after-close).
# Same discipline as fread/fwrite above — a definite use of an fclose'd handle is refuted.
[getc fgetc getc_unlocked fgets fputs fputc putc scanf fscanf vfscanf ungetc fgetpos fsetpos setbuf setvbuf]
typestate-require-not arg0 file closed

# --- More kernel refcount pairs (get/put must balance; a put on an already-zero ref is a UAF, a
# missing put is a leak). Each pair mirrors the kref pattern: inc on get, dec on put. Keyed per
# object family so an inc of one is not balanced by a put of another.
[dget dget_parent]
refcount-inc arg0 dentry
[dput]
refcount-dec arg0 dentry
[fget fget_raw get_file]
refcount-inc arg0 file_ref
[fput]
refcount-dec arg0 file_ref
[mntget]
refcount-inc arg0 mount
[mntput]
refcount-dec arg0 mount
[try_module_get __module_get]
refcount-inc arg0 module
[module_put]
refcount-dec arg0 module

# --- sk_buff double-free / use-after-free: freeing an skb twice, or touching it after free, is a
# common kernel bug. Mirror the fclose pattern — a free requires the skb is not already freed, then
# marks it freed. (Only the free side is modelled: an accessor-side require would be broad and risk
# a false FAIL on a legitimately-reallocated pointer.)
[kfree_skb consume_skb kfree_skb_reason dev_kfree_skb kfree_skb_list]
typestate-require-not arg0 skb freed
typestate-set arg0 skb freed
